@startuml PTP_EW_05_9_Environment
title EW Frontend environment configuration flow

actor "Deployment\n(compose / Helm)" as DEPLOY
participant "Container entrypoint" as ENTRY
participant "assets/env.js" as ENVJS
participant "EWConfig\n(runtime environment module)" as CFG
participant "Angular / Ionic application" as APP

DEPLOY -> ENTRY : environment variables
ENTRY -> ENVJS : substitute sample config
ENVJS -> CFG : window.ENV
CFG -> APP : ptp / keycloak / kibana / blobs configuration
@enduml
